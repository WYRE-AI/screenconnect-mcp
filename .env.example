# Local stdio / AUTH_MODE=env. Set real values in your local environment only.
SCREENCONNECT_BASE_URL=https://<instance>.screenconnect.com
SCREENCONNECT_API_SECRET=
# SCREENCONNECT_ORIGIN=https://portal.screenconnect.com
SCREENCONNECT_EXTENSION_ID=2d558935-686a-4bd0-9991-07539f5fe749
SCREENCONNECT_TOOL_TIERS=read
SCREENCONNECT_REQUEST_TIMEOUT_MS=30000
SCREENCONNECT_MAX_RESPONSE_CHARS=60000
SCREENCONNECT_MAX_UPSTREAM_BYTES=16777216
# SCREENCONNECT_ALLOW_PRIVATE_BASE_URL=1
MCP_TRANSPORT=stdio
AUTH_MODE=env
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
# Required for HTTP except loopback-only insecure development:
CONDUIT_S2S_SECRET=
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# MCP_ALLOW_INSECURE_DEV=1
LOG_LEVEL=info
